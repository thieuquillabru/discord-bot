# Token du bot (obtenu depuis le Discord Developer Portal)
DISCORD_TOKEN=VOTRE_TOKEN_ICI

# ID du serveur (pour enregistrer les commandes slash)
GUILD_ID=VOTRE_ID_SERVEUR_ICI

# ID du canal de bienvenue
WELCOME_CHANNEL_ID=VOTRE_ID_CANAL_BIENVENUE_ICI

# ID de la catégorie pour les tickets
TICKET_CATEGORY_ID=VOTRE_ID_CATEGORIE_TICKETS_ICI

# ID du rôle de modérateur (pour les permissions)
MOD_ROLE_ID=VOTRE_ID_ROLE_MODERATEUR_ICI
